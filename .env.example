# Copie ce fichier en « .env » et remplis les valeurs. Le fichier .env ne doit JAMAIS aller sur GitHub.

# Clé qui signe les sessions (64 caractères aléatoires). Générer :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# production : refuse de démarrer sans SECRET_KEY
ENVIRONNEMENT=developpement

# Base de données (SQLite par défaut ; PostgreSQL en ligne, ex : postgresql://...)
DATABASE_URL=sqlite:///./ecole.db

# Abonnements
ESSAI_JOURS=30
CONTACT_ABONNEMENT=+224 6xx xx xx xx
# « non » : seules les écoles créées par le super admin peuvent exister
INSCRIPTION_PUBLIQUE=oui

# Durée d'une session (heures)
TOKEN_HEURES=12

# ---------- SMS automatiques (rappels groupés, codes « mot de passe oublié ») ----------
# simulation : rien n'est envoyé (tests) · orange : API SMS d'Orange (payant, https://developer.orange.com)
# Laisser vide : pas d'envoi automatique (l'assistant WhatsApp « un clic par parent » reste disponible)
SMS_FOURNISSEUR=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Numéro expéditeur fourni par Orange, ex : tel:+2240000
ORANGE_EXPEDITEUR=
ORANGE_NOM_EXPEDITEUR=

# ---------- E-mail (codes « mot de passe oublié ») ----------
# SMTP_HOTE=simulation pour tester sans envoyer
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=
